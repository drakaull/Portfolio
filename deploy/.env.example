# Production settings. On the server: copy to deploy/.env, fill in, and never commit it.
# Lines starting with # are explanations. See docs/deployment.md for each step.

# --- Addresses (Caddy) -------------------------------------------------------------------------
# The site's one address; Caddy gets its HTTPS certificate automatically.
SITE_ADDRESS=leonard-fontaine.com
# The same address as a full URL: where the other names below are redirected.
SITE_URL=https://leonard-fontaine.com
# Every other name, comma-separated: each redirects permanently to SITE_URL.
REDIRECT_ADDRESSES=www.leonard-fontaine.com, leonard-fontaine.be, www.leonard-fontaine.be
# The Game of Life, a static site of its own (deploy/update-life.sh puts it online).
LIFE_ADDRESS=life.leonard-fontaine.com
# Let's Encrypt writes here if a certificate cannot be renewed.
ACME_EMAIL=contact@leonard-fontaine.com

# --- Database ----------------------------------------------------------------------------------
# A long random password, generated on the server (see the runbook); only the backend uses it.
POSTGRES_PASSWORD=change-me

# --- Backend -----------------------------------------------------------------------------------
DEBUG=false
# DeepL API Free key (ends with :fx). Without it, saving works and other languages show French.
DEEPL_API_KEY=
# Contact form: where messages are emailed (never shown on the site) and the mail server used.
CONTACT_EMAIL=contact@leonard-fontaine.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=contact@leonard-fontaine.com
