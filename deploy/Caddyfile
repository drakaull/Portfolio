# Caddy: the only service reachable from the Internet. It gets and renews the HTTPS certificates
# by itself, serves the built site, forwards /api to the backend and adds the security headers.
# The addresses come from deploy/.env (SITE_ADDRESS, SITE_URL, REDIRECT_ADDRESSES, LIFE_ADDRESS,
# SCOREFOOT_ADDRESS, ACME_EMAIL).

{
	# Let's Encrypt writes here about certificates that are about to expire.
	email {$ACME_EMAIL}

	# There is no access log, but warnings and errors (a visitor who hangs up, an app that does not
	# answer) describe the request: strip whatever identifies the visitor, keep the rest to debug.
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>User-Agent delete
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

# Every other name (.be, www.) goes permanently to the one address of the site.
{$REDIRECT_ADDRESSES} {
	redir {$SITE_URL}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Bigger requests are refused before reaching the app (the CV and the photo are 5 MB at most).
	request_body {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# The React app. Its pages are all index.html (the app shows its own 404, marked noindex).
	handle {
		root * /srv
		# Only the site's own files: no inline script, no third-party resource, no framing. (Fonts also
		# allow data: — Vite inlines the smallest font files into the CSS.)
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Built files have a content hash in their name: they never change, cache them for a year.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Everything else is checked again on each visit, so a new release shows at once.
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

# The Game of Life (github.com/drakaull/game-of-life): a static site, built on this server by
# deploy/update-life.sh into ~/sites/life. One page: any other path is a plain 404 (no try_files).
# No log directive here either: no access log, so no visitor address is kept.
{$LIFE_ADDRESS} {
	root * /srv/sites/life
	encode zstd gzip

	# The exact headers of the game's checklist (its `npm run preview` sends the same ones).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Hashed build files never change; the page and theme-init.js are checked again on each visit.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	file_server
}

# ScoreFoot.gg (github.com/drakaull/scorefoot.gg, its own compose project in ~/scorefoot): its
# Next.js service joins the shared "edge" network as scorefoot-web; nothing else of it is reachable.
# Next.js sends its own Content-Security-Policy (a fresh nonce on each page), so none is set here.
# Caddy passes the visitor's address in X-Forwarded-For: ScoreFoot rate-limits searches with it.
# No log directive here either: no access log, so no visitor address is kept.
{$SCOREFOOT_ADDRESS} {
	encode zstd gzip

	# A read-only site: nothing to upload.
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	reverse_proxy scorefoot-web:3000
}
