# Copy this file to `.env` and adjust the values. Never commit `.env`.
DEBUG=true

# Local PostgreSQL from docker-compose.yml. Tests use the same server with the `portfolio_test` database.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# Folder for uploaded files (CV as storage/cv.pdf). Git-ignored.
STORAGE_DIR=storage

# DeepL API Free key (ends with :fx) for automatic translation. Optional; never commit the real key.
DEEPL_API_KEY=

# Contact form. Messages are emailed to CONTACT_EMAIL (never shown on the site); without it they
# are only kept in the admin inbox. Locally, Mailpit catches every email: http://localhost:8025
CONTACT_EMAIL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=portfolio@localhost
SMTP_STARTTLS=false
